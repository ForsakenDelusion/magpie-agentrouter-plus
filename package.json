{
  "name": "magpie-agentrouter-plus",
  "version": "0.2.0",
  "description": "Independently maintained AgentRouter plugin for Magpie: selectable domestic/international APIs, safe Responses history replay and account features",
  "type": "module",
  "main": "./index.mjs",
  "scripts": {
    "test:policy": "node --test .github/scripts/pr-policy.test.cjs",
    "test": "node --test",
    "test:headers": "python3 set-ar-headers.test.py"
  },
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "endpoints.mjs",
    "response.mjs",
    "request.mjs",
    "body-inspection.mjs",
    "github-cookie.mjs",
    "content-filter.mjs",
    "content-filter.example.json",
    "local-checkin.mjs",
    "windows-acl.mjs",
    "LOCAL-CHECKIN.md",
    "README.md",
    "CHANGELOG.md",
    "docs/OPTIMIZATION.md",
    "docs/UPSTREAM-README.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "magpie-plugin",
    "agentrouter",
    "llm-gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForsakenDelusion/magpie-agentrouter-plus.git"
  },
  "engines": {
    "node": ">=20"
  },
  "magpie": {
    "maxConcurrency": 2
  }
}
